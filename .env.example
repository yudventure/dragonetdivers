# Salin menjadi .env.local untuk development. Di Hostinger, isi lewat
# hPanel → Websites → dragonetdiversrajaampat.com → Environment variables.
# File berisi kredensial jangan di-commit ke GitHub.
# hPanel tidak menerima value kosong: isi "-" untuk key yang belum diisi (dibaca sama dengan kosong).

# Nilai publik (tampil di browser). Perubahan perlu build ulang.
# Domain utama website. Domain situs lain dan www. dialihkan ke sini (HOSTINGER-DEPLOY.md bagian 3).
NEXT_PUBLIC_SITE_URL=https://dragonetdiversrajaampat.com
# Nomor WhatsApp booking dengan kode negara, mis. 6281234567890 atau +62 812-3456-7890 (0812... dianggap +62).
# Kosongkan bila belum ada; tombol WhatsApp disembunyikan.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Media sosial untuk ikon di footer: handle (@dragonetdiversrajaampat) atau URL lengkap.
# Kosongkan yang belum ada; ikonnya tidak ditampilkan.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_YOUTUBE=

# Database MySQL Hostinger (hPanel → Databases → MySQL Databases).
# Pakai nama database & user lengkap termasuk prefix (mis. u123456789_dragonet).
# Jangan beri awalan NEXT_PUBLIC_ pada variabel database.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Opsional: aktifkan bila penyedia database mewajibkan TLS terverifikasi.
# MYSQL_SSL=true
# Opsional: hanya bila Hostinger memberi path Unix socket untuk proses aplikasi.
# MYSQL_SOCKET=

# PORT disediakan Hostinger; tidak perlu diisi.

# Opsional: kurs tetap Rupiah per 1 US$ untuk pilihan mata uang (mis. 16250). Kosong = kurs harian
# Bank Sentral Eropa lewat Frankfurter, diperbarui otomatis.
USD_IDR_RATE=

# Pembayaran paket. Rahasia: hanya di hPanel, jangan pernah di-commit. Mulai dengan key sandbox.
# Midtrans: Server Key (SB-Mid-server-… untuk uji coba). MIDTRANS_PRODUCTION=true untuk pembayaran sungguhan.
MIDTRANS_SERVER_KEY=
# MIDTRANS_PRODUCTION=true
# PayPal: developer.paypal.com → Apps & Credentials. PAYPAL_MODE=live untuk pembayaran sungguhan.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=live

# Login dashboard tim (/admin, tautan "Operator sign in" di footer). Rahasia: hanya di hPanel,
# jangan pernah di-commit. Tanpa ADMIN_EMAIL dan ADMIN_PASSWORD tidak ada yang bisa masuk.
ADMIN_EMAIL=
# Minimal 10 karakter.
ADMIN_PASSWORD=
# Teks acak panjang untuk menandatangani sesi, mis. hasil: openssl rand -base64 48
SESSION_SECRET=

# Email dari website lewat SMTP: kode "Lupa password" admin dan email pesanan ke tamu (pesanan
# diterima, pengingat bayar, pembayaran diterima). Email Hostinger: smtp.hostinger.com port 465.
# Rahasia: hanya di hPanel. Tanpa SMTP_HOST, SMTP_USER, dan SMTP_PASS tidak ada email yang dikirim.
SMTP_HOST=
# 465 (SSL, bawaan) atau 587 (STARTTLS).
SMTP_PORT=465
# Alamat email pengirim lengkap, mis. halo@dragonetdiversrajaampat.com
SMTP_USER=
SMTP_PASS=
# Opsional. Nama dan alamat pengirim, mis. Dragonet Divers <halo@dragonetdiversrajaampat.com>
SMTP_FROM=
# Opsional. Kotak masuk penerima kode "Lupa password". Kosong = dikirim ke ADMIN_EMAIL.
ADMIN_OTP_EMAIL=
