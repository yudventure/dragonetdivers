# Salin menjadi .env.local untuk development. Di Hostinger, isi lewat
# hPanel → Websites → dragonetdivers.com → Environment variables.
# File berisi kredensial jangan di-commit ke GitHub.

# Nilai publik (tampil di browser). Perubahan perlu build ulang.
NEXT_PUBLIC_SITE_URL=https://dragonetdivers.com
# Nomor WhatsApp booking: kode negara + angka, tanpa +, spasi, atau 0 di depan.
# Kosongkan bila belum ada; tombol WhatsApp disembunyikan.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Database MySQL Hostinger (hPanel → Databases → MySQL Databases).
# Pakai nama database & user lengkap termasuk prefix (mis. u123456789_dragonet).
# Jangan beri awalan NEXT_PUBLIC_ pada variabel database.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Opsional: aktifkan bila penyedia database mewajibkan TLS terverifikasi.
# MYSQL_SSL=true
# Opsional: hanya bila Hostinger memberi path Unix socket untuk proses aplikasi.
# MYSQL_SOCKET=

# PORT disediakan Hostinger; tidak perlu diisi.
